# Environment configuration for Nakaam backend
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (MongoDB connection URI)
MONGODB_URI=mongodb://localhost:27017/nakaam_db

# Authentication (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Security & Encryption (32-byte Base64 key for AES-256-GCM encryption of CNIC etc.)
FIELD_ENCRYPTION_KEY=

# Initial Admin Credentials (used by seedAdmin job)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_ROLE=

# Pagination & Cache Defaults
PAGINATION_DEFAULT_LIMIT=20
# Per-section page sizes
PRODUCTS_PAGE_SIZE=15
ADMIN_ORDERS_PAGE_SIZE=15
ADMIN_CUSTOMERS_PAGE_SIZE=20
ADMIN_REVIEWS_PAGE_SIZE=20
ADMIN_CATEGORIES_PAGE_SIZE=15
ADMIN_COMPLAINTS_PAGE_SIZE=20
ADMIN_COUPONS_PAGE_SIZE=20
NOTIFICATIONS_PAGE_SIZE=20
USER_ORDERS_PAGE_SIZE=10
WISHLIST_PAGE_SIZE=24
CACHE_MAX_ENTRIES=50000
CACHE_TTL_STOCK=15
CACHE_TTL_PRODUCT=180
CACHE_TTL_CATEGORY=720

# Cloudinary Direct Uploads
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_ROOT_FOLDER=

# Email (SMTP Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Store Defaults
STORE_WHATSAPP_NUMBER=

# MongoDB TTL and auth expiration policy (durations are configurable per deployment)
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
SESSION_MAX_AGE_DAYS=14
RATE_LIMIT_WINDOW_MINUTES=15
ABANDONED_CART_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=60
UNPAID_ORDER_EXPIRY_HOURS=24
RESOLVED_DELIVERY_REPORTS_RETENTION_DAYS=180
CLOSED_COMPLAINTS_RETENTION_DAYS=365

# MongoDB's TTL monitor removes expired temporary records asynchronously.
# Expired unpaid orders are deleted without restoring reserved stock.
ACCOUNT_DELETE_ORDER_MODE=anonymize
